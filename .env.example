# ProCal Core public self-hosted example env.
# Copy to .env and replace the passwords before starting.

PROCAL_SELF_BIND_IP=0.0.0.0
PROCAL_SELF_PORT=8080
PROCAL_SELF_TRUST_PROXY=0
PROCAL_SELF_APP_VERSION=0.9.9-community
PROCAL_CORE_IMAGE=ghcr.io/replace-owner/procal-core-public:latest
TZ=Europe/Sofia

PROCAL_SELF_DB_ROOT_PASSWORD=replace-with-a-long-random-root-password
PROCAL_SELF_DB_NAME=procal
PROCAL_SELF_DB_USER=procal
PROCAL_SELF_DB_PASSWORD=replace-with-a-long-random-app-password

# Optional mobile push.
# Leave blank to keep Firebase push disabled.
# Use only a Firebase project owned by this self-hosted installation owner.
# PROCAL_FCM_SERVICE_ACCOUNT_JSON_BASE64=
# PROCAL_PUSH_PAYLOAD_MODE=generic
