generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  system_admin
  admin
  boss
  hr
  pr
  user
  role_a
  role_b
  role_c
  role_d
}

enum UserStatus {
  pending
  active
  suspended
}

enum UserViewMode {
  simple
  tasks
}

enum PermissionEffect {
  allow
  deny
}

enum EventScope {
  private
  team
  global
}

enum TaskStatus {
  open
  in_progress
  done
  archived
}

enum NoteVisibility {
  private
  team
}

enum ChatMessageScope {
  global
  direct
}

enum AttendancePunchKind {
  check_in
  check_out
  void
}

enum AttendancePunchSource {
  web
  nfc
  admin
}

enum InventoryMovementType {
  receive
  issue
  transfer
  adjustment
}

enum InventoryStockStatus {
  normal
  low
  critical
}

model AppMeta {
  id            Int      @id @default(1)
  installed     Boolean  @default(false)
  haWebhookUrl  String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model User {
  id             String         @id @default(cuid())
  username       String         @unique
  nickname       String?
  fullName       String?        @db.VarChar(191)
  workplace      String?        @db.VarChar(191)
  jobTitle       String?        @db.VarChar(191)
  passwordHash   String
  role           UserRole       @default(user)
  status         UserStatus     @default(pending)
  viewMode       UserViewMode   @default(simple)
  displayColor   String?
  calendarTintOpacity Int      @default(10)
  isDeleted      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  eventsCreated  Event[]
  tasksOwned     Task[]         @relation("TaskOwner")
  notes          Note[]
  refreshTokens  RefreshToken[]
  serviceTokens  ServiceToken[]
  memberships    TaskMember[]
  auditLogs      AuditLog[]
  legacyState    LegacyState?
  permissionOverrides UserPermissionOverride[]
  compensationBalance CompensationBalance?
  compensationEntries CompensationEntry[] @relation("CompensationTarget")
  compensationActions CompensationEntry[] @relation("CompensationActor")
  leaveAllowances LeaveAllowance[] @relation("LeaveAllowanceTarget")
  leaveAllowanceActions LeaveAllowance[] @relation("LeaveAllowanceActor")
  leaveRecords LeaveRecord[] @relation("LeaveRecordTarget")
  leaveRecordActions LeaveRecord[] @relation("LeaveRecordActor")
  leaveSubstitutions LeaveRecord[] @relation("LeaveRecordSubstitute")
  notifications Notification[]
  notificationPreferences NotificationPreference[]
  bugReports    BugReport[]
  mediaOwnedPublications MediaOwnedPublication[] @relation("MediaOwnedCreatedBy")
  mediaObservedMentions MediaObservedMention[] @relation("MediaObservedCreatedBy")
  sentChatMessages ChatMessage[] @relation("ChatMessageSender")
  receivedChatMessages ChatMessage[] @relation("ChatMessageRecipient")
  chatThreadReads ChatThreadRead[]
  pushDevices   PushDevice[]
  eventReminderDeliveries EventReminderDelivery[]
  attendancePunches AttendancePunch[] @relation("AttendancePunchTarget")
  attendanceActions AttendancePunch[] @relation("AttendancePunchActor")
  attendanceStationsCreated AttendanceStation[] @relation("AttendanceStationCreator")
  inventoryItemsCreated InventoryItem[] @relation("InventoryItemCreator")
  inventoryLocationsCreated InventoryLocation[] @relation("InventoryLocationCreator")
  inventoryMovementsCreated InventoryMovement[] @relation("InventoryMovementCreator")
}

model Event {
  id            String    @id @default(cuid())
  date          DateTime
  title         String
  description   String?
  scope         EventScope @default(global)
  createdById   String
  isDeleted     Boolean   @default(false)
  version       Int       @default(1)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     User      @relation(fields: [createdById], references: [id])
  tasks         Task[]
  notes         Note[]

  @@index([date])
  @@index([updatedAt])
}

model Task {
  id            String      @id @default(cuid())
  eventId       String
  title         String
  description   String?
  status        TaskStatus  @default(open)
  dueAt         DateTime?
  remindAt      DateTime?
  ownerId       String?
  isDeleted     Boolean     @default(false)
  version       Int         @default(1)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  event         Event       @relation(fields: [eventId], references: [id])
  owner         User?       @relation("TaskOwner", fields: [ownerId], references: [id])
  members       TaskMember[]

  @@index([eventId])
  @@index([updatedAt])
  @@index([dueAt])
}

model TaskMember {
  taskId        String
  userId        String
  createdAt     DateTime @default(now())
  task          Task     @relation(fields: [taskId], references: [id])
  user          User     @relation(fields: [userId], references: [id])

  @@id([taskId, userId])
}

model Note {
  id            String         @id @default(cuid())
  eventId       String
  authorId      String
  text          String
  visibility    NoteVisibility
  isDeleted     Boolean        @default(false)
  version       Int            @default(1)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  event         Event          @relation(fields: [eventId], references: [id])
  author        User           @relation(fields: [authorId], references: [id])

  @@index([eventId])
  @@index([updatedAt])
}

model RefreshToken {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique
  expiresAt     DateTime
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ServiceToken {
  id            String    @id @default(cuid())
  userId        String?
  name          String
  tokenHash     String    @unique
  tokenPrefix   String
  revokedAt     DateTime?
  lastUsedAt    DateTime?
  createdAt     DateTime  @default(now())
  user          User?     @relation(fields: [userId], references: [id])

  @@index([userId])
}

model AuditLog {
  id            BigInt    @id @default(autoincrement())
  actorUserId   String?
  action        String
  entityType    String
  entityId      String?
  metaJson      Json?
  createdAt     DateTime  @default(now())
  actorUser     User?     @relation(fields: [actorUserId], references: [id])

  @@index([createdAt])
}

model IdempotencyRecord {
  id            String    @id @default(cuid())
  key           String    @unique
  endpoint      String
  userId        String?
  requestHash   String
  statusCode    Int
  responseBody  Json
  createdAt     DateTime  @default(now())
  expiresAt     DateTime

  @@index([expiresAt])
}

model LegacyState {
  id            String    @id @default(cuid())
  userId        String    @unique
  dataJson      Json
  version       Int       @default(1)
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id])
}

model RolePolicy {
  id              String   @id @default(cuid())
  role            UserRole @unique
  displayName     String?
  permissionsJson Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model UserPermissionOverride {
  id          String           @id @default(cuid())
  userId      String
  permission  String
  effect      PermissionEffect
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  user        User             @relation(fields: [userId], references: [id])

  @@unique([userId, permission])
  @@index([userId])
}

model SharedLegacyState {
  id            Int      @id @default(1)
  dataJson      Json
  version       Int      @default(1)
  updatedAt     DateTime @updatedAt
}

enum CompensationEntryKind {
  overtime
  absence
  adjustment
}

enum LeaveType {
  paid
  sick
  unpaid
  study
}

enum LeaveRecordStatus {
  pending
  approved
  rejected
}

model CompensationBalance {
  id        String   @id @default(cuid())
  userId    String   @unique
  minutes   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])
}

model CompensationEntry {
  id           String                @id @default(cuid())
  userId       String
  createdById  String?
  minutesDelta Int
  reason       String?
  kind         CompensationEntryKind @default(adjustment)
  createdAt    DateTime              @default(now())
  user         User                  @relation("CompensationTarget", fields: [userId], references: [id])
  createdBy    User?                 @relation("CompensationActor", fields: [createdById], references: [id])

  @@index([userId, createdAt])
  @@index([createdById])
  @@index([createdAt])
}

model LeaveAllowance {
  id           String    @id @default(cuid())
  userId       String
  leaveType    LeaveType
  year         Int
  days         Decimal   @db.Decimal(8, 2)
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation("LeaveAllowanceTarget", fields: [userId], references: [id])
  createdBy    User?     @relation("LeaveAllowanceActor", fields: [createdById], references: [id])

  @@unique([userId, leaveType, year])
  @@index([userId, leaveType])
  @@index([year])
}

model LeaveRecord {
  id           String    @id @default(cuid())
  userId       String
  leaveType    LeaveType
  status       LeaveRecordStatus @default(approved)
  startDate    DateTime
  endDate      DateTime
  days         Decimal   @db.Decimal(8, 2)
  sourceYear   Int?
  note         String?   @db.VarChar(512)
  createdById  String?
  substituteUserId String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  user         User      @relation("LeaveRecordTarget", fields: [userId], references: [id])
  createdBy    User?     @relation("LeaveRecordActor", fields: [createdById], references: [id])
  substituteUser User?    @relation("LeaveRecordSubstitute", fields: [substituteUserId], references: [id], onDelete: SetNull)

  @@index([userId, startDate, endDate])
  @@index([substituteUserId, startDate, endDate])
  @@index([leaveType, startDate])
  @@index([sourceYear])
}

model Notification {
  id         String   @id @default(cuid())
  userId     String
  type       String
  title      String
  body       String?  @db.VarChar(1000)
  entityType String?  @db.VarChar(120)
  entityId   String?  @db.VarChar(191)
  metaJson   Json?
  createdAt  DateTime @default(now())
  readAt     DateTime?
  userHiddenAt DateTime?
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([userId, readAt, createdAt])
  @@index([userId, userHiddenAt, createdAt])
}

model NotificationPreference {
  id        String   @id @default(cuid())
  userId    String
  type      String
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, type])
  @@index([type])
}

model EventReminderDelivery {
  id          String   @id @default(cuid())
  userId      String
  reminderKey String   @db.VarChar(191)
  eventId     String   @db.VarChar(191)
  dueAt       DateTime
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])

  @@unique([userId, reminderKey])
  @@index([dueAt])
  @@index([eventId])
}

model PushDevice {
  id                   String   @id @default(cuid())
  userId               String
  platform             String   @db.VarChar(32)
  installationId       String   @unique @db.VarChar(191)
  token                String   @unique @db.VarChar(512)
  appVersion           String?  @db.VarChar(64)
  deviceLabel          String?  @db.VarChar(191)
  notificationsEnabled Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  lastSeenAt           DateTime @default(now())
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, platform])
  @@index([lastSeenAt])
}

enum BugReportStatus {
  open
  triaged
  resolved
  dismissed
}

model BugReport {
  id          String          @id @default(cuid())
  userId      String
  userName    String          @db.VarChar(191)
  title       String          @db.VarChar(191)
  description String          @db.VarChar(4000)
  pageUrl     String?         @db.VarChar(1000)
  appVersion  String?         @db.VarChar(40)
  status      BugReportStatus @default(open)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([status, createdAt])
  @@index([userId, createdAt])
}

model MediaOwnedPublication {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(300)
  url         String   @db.VarChar(1000)
  publishedAt DateTime
  createdById String?
  createdByName String @db.VarChar(191)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation("MediaOwnedCreatedBy", fields: [createdById], references: [id])
  mentions    MediaObservedMention[]

  @@index([publishedAt])
  @@index([createdById, createdAt])
}

model MediaObservedMention {
  id          String   @id @default(cuid())
  title       String   @db.VarChar(300)
  url         String   @db.VarChar(1000)
  publishedAt DateTime
  linkedOwnedId String?
  createdById String?
  createdByName String @db.VarChar(191)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  linkedOwned MediaOwnedPublication? @relation(fields: [linkedOwnedId], references: [id])
  createdBy   User?    @relation("MediaObservedCreatedBy", fields: [createdById], references: [id])

  @@index([publishedAt])
  @@index([linkedOwnedId, publishedAt])
  @@index([createdById, createdAt])
}

model ChatMessage {
  id              String           @id @default(cuid())
  scope           ChatMessageScope
  senderId        String
  recipientUserId String?
  body            String           @db.VarChar(4000)
  createdAt       DateTime         @default(now())
  sender          User             @relation("ChatMessageSender", fields: [senderId], references: [id])
  recipient       User?            @relation("ChatMessageRecipient", fields: [recipientUserId], references: [id])

  @@index([scope, createdAt])
  @@index([recipientUserId, createdAt])
  @@index([senderId, createdAt])
}

model ChatThreadRead {
  userId      String
  threadKey   String   @db.VarChar(191)
  lastReadAt  DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id])

  @@id([userId, threadKey])
  @@index([userId, updatedAt])
}

model AttendanceStation {
  id          String   @id @default(cuid())
  name        String   @db.VarChar(191)
  location    String?  @db.VarChar(191)
  tokenHash   String   @unique @db.VarChar(64)
  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User?    @relation("AttendanceStationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  punches     AttendancePunch[]

  @@index([active, name])
  @@index([createdById])
}

model AttendancePunch {
  id            String                @id @default(cuid())
  userId        String
  kind          AttendancePunchKind
  occurredAt    DateTime
  source        AttendancePunchSource @default(web)
  stationId     String?
  note          String?               @db.VarChar(512)
  reason        String?               @db.VarChar(512)
  createdById   String?
  targetPunchId String?               @unique
  createdAt     DateTime              @default(now())
  user          User                  @relation("AttendancePunchTarget", fields: [userId], references: [id])
  createdBy     User?                 @relation("AttendancePunchActor", fields: [createdById], references: [id], onDelete: SetNull)
  station       AttendanceStation?    @relation(fields: [stationId], references: [id], onDelete: SetNull)
  targetPunch   AttendancePunch?      @relation("AttendancePunchCorrection", fields: [targetPunchId], references: [id])
  supersededBy  AttendancePunch[]     @relation("AttendancePunchCorrection")

  @@index([userId, occurredAt])
  @@index([stationId, occurredAt])
  @@index([createdById, createdAt])
  @@index([kind, occurredAt])
}

model InventoryLocation {
  id                   String                  @id @default(cuid())
  name                 String                  @unique @db.VarChar(191)
  description          String?                 @db.VarChar(512)
  active               Boolean                 @default(true)
  createdById          String?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  createdBy            User?                   @relation("InventoryLocationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  sourceMovements      InventoryMovement[]     @relation("InventoryMovementSource")
  destinationMovements InventoryMovement[]     @relation("InventoryMovementDestination")
  itemSettings         InventoryItemLocation[]
  alertStates          InventoryStockAlertState[]

  @@index([active, name])
  @@index([createdById])
}

model InventoryItem {
  id                     String                  @id @default(cuid())
  sku                    String                  @unique @db.VarChar(191)
  name                   String                  @db.VarChar(300)
  description            String?                 @db.VarChar(2000)
  category               String?                 @db.VarChar(191)
  unit                   String                  @default("pcs") @db.VarChar(32)
  lowStockThreshold      Decimal?                @db.Decimal(14, 3)
  criticalStockThreshold Decimal?                @db.Decimal(14, 3)
  restockTarget          Decimal?                @db.Decimal(14, 3)
  notificationsEnabled   Boolean                 @default(true)
  qrTokenHash            String                  @unique @db.VarChar(64)
  active                 Boolean                 @default(true)
  createdById            String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  createdBy              User?                   @relation("InventoryItemCreator", fields: [createdById], references: [id], onDelete: SetNull)
  movements              InventoryMovement[]
  locationSettings       InventoryItemLocation[]
  alertStates            InventoryStockAlertState[]

  @@index([active, name])
  @@index([category, name])
  @@index([createdById])
}

model InventoryItemLocation {
  itemId                 String
  locationId             String
  lowStockThreshold      Decimal?          @db.Decimal(14, 3)
  criticalStockThreshold Decimal?          @db.Decimal(14, 3)
  restockTarget          Decimal?          @db.Decimal(14, 3)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  item                   InventoryItem     @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location               InventoryLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([itemId, locationId])
  @@index([locationId])
}

model InventoryMovement {
  id                    String                @id @default(cuid())
  itemId                String
  type                  InventoryMovementType
  quantity              Decimal               @db.Decimal(14, 3)
  sourceLocationId      String?
  destinationLocationId String?
  reason                String?               @db.VarChar(512)
  note                  String?               @db.VarChar(1000)
  createdById           String?
  reversesMovementId    String?               @unique
  createdAt             DateTime              @default(now())
  item                  InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  sourceLocation        InventoryLocation?    @relation("InventoryMovementSource", fields: [sourceLocationId], references: [id], onDelete: SetNull)
  destinationLocation   InventoryLocation?    @relation("InventoryMovementDestination", fields: [destinationLocationId], references: [id], onDelete: SetNull)
  createdBy             User?                 @relation("InventoryMovementCreator", fields: [createdById], references: [id], onDelete: SetNull)
  reverses              InventoryMovement?    @relation("InventoryMovementReversal", fields: [reversesMovementId], references: [id], onDelete: SetNull)
  reversedBy            InventoryMovement[]   @relation("InventoryMovementReversal")

  @@index([itemId, createdAt])
  @@index([sourceLocationId, createdAt])
  @@index([destinationLocationId, createdAt])
  @@index([createdById, createdAt])
  @@index([type, createdAt])
}

model InventoryStockAlertState {
  itemId         String
  locationId     String
  status         InventoryStockStatus @default(normal)
  lastNotifiedAt DateTime?
  updatedAt      DateTime               @updatedAt
  item           InventoryItem         @relation(fields: [itemId], references: [id], onDelete: Cascade)
  location       InventoryLocation     @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@id([itemId, locationId])
  @@index([status, updatedAt])
}

model InventorySettings {
  id                   Int      @id @default(1)
  notificationsEnabled Boolean  @default(true)
  inAppEnabled         Boolean  @default(true)
  pushEnabled          Boolean  @default(true)
  notifyManagers       Boolean  @default(true)
  notifyOnRestored     Boolean  @default(true)
  repeatHours          Int      @default(24)
  recipientUserIds     Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

