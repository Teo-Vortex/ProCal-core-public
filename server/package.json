    "prisma:migrate": "prisma migrate deploy",
    "admin:recover-first": "node dist/tools/recoverFirstAdmin.js",
    "admin:recover-first:dev": "tsx src/tools/recoverFirstAdmin.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "archiver": "7.0.1",
    "bcrypt": "6.0.0",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "dotenv": "16.4.7",
    "express": "4.22.2",
    "express-rate-limit": "7.5.0",
    "firebase-admin": "14.2.0",
    "helmet": "8.1.0",
    "http-errors": "2.0.0",
    "jsonwebtoken": "9.0.2",
    "multer": "2.2.0",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "prisma": "5.22.0",
    "qrcode": "^1.5.4",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@types/archiver": "6.0.3",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.8",
