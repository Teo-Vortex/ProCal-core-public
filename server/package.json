    "@types/express": "5.0.0",
    "@types/jsonwebtoken": "9.0.8",
    "@types/multer": "^2.1.0",
    "@types/node": "22.10.5",
    "@types/qrcode": "^1.5.5",
    "tsx": "4.23.8",
    "typescript": "5.7.3"
  },
  "overrides": {
    "body-parser": "1.20.6",
